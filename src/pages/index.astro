---
import Layout from '../layouts/Layout.astro';
import { learningModules } from '../data/learningModules';
import Flashcard from '../components/Flashcard.astro';
---

<Layout title="Home" activePage="home">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 bg-blue-50 text-blue-700 px-4 py-2 rounded-full text-sm font-medium mb-6 animate-on-scroll">
        <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
        New Hire Training Platform
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4 animate-on-scroll">
        Master <span class="text-blue-600">ISO 42001</span> <span class="inline-block animate-wave">🤖</span>
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto animate-on-scroll delay-1">
        Everything you need to help clients achieve ISO 42001 AI Management System certification. 
        Learn the standard, understand the controls, and deliver results.
      </p>
      <p class="text-sm text-gray-400 mt-3 animate-on-scroll delay-2">Created by <strong class="text-gray-500">Ruchi Kandpal</strong></p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mb-12">
      <a href="/modules" class="group bg-white rounded-2xl border border-gray-200 p-8 hover:border-blue-300 transition-all card-hover animate-on-scroll">
        <div class="text-4xl mb-4">📚</div>
        <h2 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">Learning Modules</h2>
        <p class="text-gray-600 mb-4">Structured lessons covering every aspect of ISO 42001 — from fundamentals to client delivery.</p>
        <div class="flex items-center gap-4 text-sm">
          <span class="text-blue-600 font-medium">{learningModules.length} Modules</span>
          <span class="text-gray-400">•</span>
          <span class="text-gray-500">{learningModules.reduce((acc, m) => acc + m.lessons.length, 0)} Lessons</span>
          <span class="text-gray-400">•</span>
          <span class="text-gray-500">Quizzes & Best Practices</span>
        </div>
      </a>

      <a href="/roadmap" class="group bg-white rounded-2xl border border-gray-200 p-8 hover:border-green-300 transition-all card-hover animate-on-scroll delay-1">
        <div class="text-4xl mb-4">🚀</div>
        <h2 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-green-600 transition-colors">30-45 Day Roadmap</h2>
        <p class="text-gray-600 mb-4">Accelerated implementation plan for clients who need ISO 42001 compliance fast.</p>
        <div class="flex items-center gap-4 text-sm">
          <span class="text-green-600 font-medium">Week-by-Week Plan</span>
          <span class="text-gray-400">•</span>
          <span class="text-gray-500">Deliverables per Phase</span>
          <span class="text-gray-400">•</span>
          <span class="text-gray-500">Resource Estimates</span>
        </div>
      </a>

      <a href="/overlap" class="group bg-white rounded-2xl border border-gray-200 p-8 hover:border-purple-300 transition-all card-hover animate-on-scroll delay-2">
        <div class="text-4xl mb-4">🔗</div>
        <h2 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-purple-600 transition-colors">27001 ↔ 42001 Overlap</h2>
        <p class="text-gray-600 mb-4">See which ISO 27001 controls can be reused — save 60-70% of implementation effort.</p>
        <div class="flex items-center gap-4 text-sm">
          <span class="text-purple-600 font-medium">Clause Mapping</span>
          <span class="text-gray-400">•</span>
          <span class="text-gray-500">Control-by-Control</span>
          <span class="text-gray-400">•</span>
          <span class="text-gray-500">Integration Tips</span>
        </div>
      </a>

      <a href="/euai" class="group bg-white rounded-2xl border border-gray-200 p-8 hover:border-blue-300 transition-all card-hover animate-on-scroll delay-3">
        <div class="text-4xl mb-4">🇪🇺</div>
        <h2 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">EU AI Act & ISO 42001</h2>
        <p class="text-gray-600 mb-4">How ISO 42001 helps demonstrate conformity with the EU AI Act — the world's first AI law.</p>
        <div class="flex items-center gap-4 text-sm">
          <span class="text-blue-600 font-medium">Risk Categories</span>
          <span class="text-gray-400">•</span>
          <span class="text-gray-500">11 Requirements Mapped</span>
          <span class="text-gray-400">•</span>
          <span class="text-gray-500">Conformity Guide</span>
        </div>
      </a>

      <a href="/nist" class="group bg-white rounded-2xl border border-gray-200 p-8 hover:border-indigo-300 transition-all card-hover animate-on-scroll delay-4">
        <div class="text-4xl mb-4">🇺🇸</div>
        <h2 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-indigo-600 transition-colors">NIST AI 600-1 & ISO 42001</h2>
        <p class="text-gray-600 mb-4">US AI Risk Management Playbook — practical guidance that complements ISO 42001.</p>
        <div class="flex items-center gap-4 text-sm">
          <span class="text-indigo-600 font-medium">4 Core Functions</span>
          <span class="text-gray-400">•</span>
          <span class="text-gray-500">12 Areas Mapped</span>
          <span class="text-gray-400">•</span>
          <span class="text-gray-500">Best of Both Worlds</span>
        </div>
      </a>

      <a href="/checklist" class="group bg-white rounded-2xl border border-gray-200 p-8 hover:border-blue-300 transition-all card-hover animate-on-scroll delay-3">
        <div class="text-4xl mb-4">✅</div>
        <h2 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">Client Readiness Checklist</h2>
        <p class="text-gray-600 mb-4">Track client compliance readiness against every ISO 42001 requirement with priority-based actions.</p>
        <div class="flex items-center gap-4 text-sm">
          <span class="text-blue-600 font-medium">22 Requirements</span>
          <span class="text-gray-400">•</span>
          <span class="text-gray-500">Priority Levels</span>
          <span class="text-gray-400">•</span>
          <span class="text-gray-500">Progress Tracking</span>
        </div>
      </a>

      <a href="/reference" class="group bg-white rounded-2xl border border-gray-200 p-8 hover:border-blue-300 transition-all card-hover animate-on-scroll delay-3">
        <div class="text-4xl mb-4">📖</div>
        <h2 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">Reference Library</h2>
        <p class="text-gray-600 mb-4">Quick-reference for ISO 42001 clauses and all Annex A controls with implementation guidance.</p>
        <div class="flex items-center gap-4 text-sm">
          <span class="text-blue-600 font-medium">7 Clauses</span>
          <span class="text-gray-400">•</span>
          <span class="text-gray-500">24 Annex A Controls</span>
          <span class="text-gray-400">•</span>
          <span class="text-gray-500">Evidence Examples</span>
        </div>
      </a>
    </div>

    <!-- Use Cases Section -->
    <div class="mb-8 animate-on-scroll">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Use Cases</h2>
      <p class="text-gray-600 mb-4">ISO 42001 finds applications across various industries and company sizes:</p>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="p-4 rounded-lg border border-gray-200 hover:border-blue-300 transition-colors">
          <h3 class="font-bold text-blue-600 text-sm">Financial Services</h3>
          <p class="text-sm text-gray-600">Banks and insurance companies managing AI risk, regulatory compliance, and customer analytics.</p></div>
        <div class="p-4 rounded-lg border border-gray-200 hover:border-green-300 transition-colors">
          <h3 class="font-bold text-green-600 text-sm">Healthcare</h3>
          <p class="text-sm text-gray-600">Healthcare providers using AI for diagnostic support, patient monitoring, and treatment optimization.</p></div>
        <div class="p-4 rounded-lg border border-gray-200 hover:border-purple-300 transition-colors">
          <h3 class="font-bold text-purple-600 text-sm">Technology</h3>
          <p class="text-sm text-gray-600">SaaS companies integrating AI features, AI model development platforms, and developer tools.</p></div>
        <div class="p-4 rounded-lg border border-gray-200 hover:border-purple-300 transition-colors">
          <h3 class="font-bold text-purple-600 text-sm">Government</h3>
          <p class="text-sm text-gray-600">Government agencies using AI for public service optimization, urban planning, and e-government services.</p>
        </div>
      </div>
      <div class="mt-6 grid md:grid-cols-2 gap-6">
        <div class="p-4 rounded-lg border border-gray-200 hover:border-blue-300 transition-colors">
          <h3 class="font-bold text-blue-600 text-sm">Startups (1-10 employees)</h3>
          <p class="text-sm text-gray-600">Quick implementation of AI governance basics, lean compliance approach, leveraging existing ISO 27001 controls.</p>>
        </div>
        <div class="p-4 rounded-lg border border-gray-200 hover:border-green-300 transition-colors">
          <h3 class="font-bold text-green-600 text-sm">Small Businesses (11-50 employees)</h3>
          <p class="text-sm text-gray-600">Focus on high-impact AI systems, limited resource optimization, leveraging existing ISO 27001 frameworks.</p>
        </div>
        <div class="p-4 rounded-lg border border-gray-200 hover:border-purple-300 transition-colors">
          <h3 class="font-bold text-purple-600 text-sm">Medium Enterprises (51-500 employees)</h3>
          <p class="text-sm text-gray-600">Comprehensive AI governance framework implementation, dedicated AI governance roles, cross-departmental AI risk management.</p>
        </div>
        <div class="p-4 rounded-lg border border-gray-200 hover:border-purple-300 transition-colors">
          <h3 class="font-bold text-purple-600 text-sm">Large Enterprises (500+ employees)</h3>
          <p class="text-sm text-gray-600">Full ISO 42001 certification pursuit, dedicated AI governance departments, enterprise-wide AI risk assessment and monitoring.</p>
        </div>
      </div>
    </div>

    <!-- Flashcards Section -->
    <div class="mt-8 animate-on-scroll">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">📋 Flashcards</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <Flashcard 
          icon="🛡️"
          title="ISO 42001 Fundamentals"
          content="ISO 42001:2023 is the world's first certifiable AI management system standard, following the ISO 27001 structure with 7 clauses and 24 Annex A controls."
        />
        <Flashcard 
          icon="📋"
          title="Key Concept: AI System"
          content="An AI system that can, for a given set of inputs, make decisions or predictions that materially affect individuals or society."
        />
        <Flashcard 
          icon="📊"
          title="Key Concept: AI System Impact Assessment (AIIA)"
          content="An AIIA evaluates how an AI system may affect people — directly or indirectly — focusing on fairness, privacy, transparency, autonomy, and safety impacts."
        />
        <Flashcard 
          icon="📋"
          title="Key Concept: AI Risk Assessment"
          content="The process of identifying, analyzing, and evaluating AI risks based on likelihood and impact, then treating them through mitigate, transfer, avoid, or accept strategies."
        />
      </div>
    </div>

    <!-- Progress Tracking Section -->
    <div class="mt-8 animate-on-scroll" data-overall-progress>
      <h2 class="text-2xl font-bold text-gray-900 mb-4">📊 Your Learning Progress</h2>
      <div class="bg-white rounded-2xl border border-gray-200 p-8">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-semibold text-gray-900">Overall Progress</h3>
          <span class="text-lg font-bold text-blue-600" data-overall-progress>0% Complete</span>
        </div>
        <div class="progress-bar" data-overall-progress>
          <div class="progress-fill" style="width: 0%"></div>
        </div>
        <p class="text-sm text-gray-500 mt-2" data-progress-text>0 of 6 modules completed</p>
      </div>
    </div>

    <!-- Quick Reference Link -->
    <div class="mt-8 animate-on-scroll">
      <a 
        href="/reference" 
        data-open-reference
        class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 text-white rounded-xl hover:bg-gray-800 transition-all group"
      >
        <span class="text-2xl">📖</span>
        <span class="font-semibold">Quick Reference: Annex A Controls</span>
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 5l7 7-7 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</Layout>