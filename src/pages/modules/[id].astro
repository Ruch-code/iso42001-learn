---
import Layout from '../../layouts/Layout.astro';
import { learningModules } from '../../data/learningModules';
import Quiz from '../../components/Quiz.tsx';
import ProgressTracker from '../../components/ProgressTracker.tsx';

export function getStaticPaths() {
  return learningModules.map(mod => ({
    params: { id: mod.id },
  }));
}

const { id } = Astro.params;
const moduleData = learningModules.find(m => m.id === id);

if (!moduleData) {
  return Astro.redirect('/modules');
}
---

<Layout title={`${moduleData.title} - ISO 42001 Learn`} activePage="modules">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <a href="/modules" class="inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-800 mb-6">
      ← Back to Modules
    </a>

    <div class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-4xl">{moduleData.icon}</span>
        <div>
          <span class="text-xs font-mono bg-gray-100 text-gray-500 px-2 py-0.5 rounded">Module {moduleData.order}</span>
          <span class="text-sm text-gray-500 ml-2">{moduleData.duration}</span>
        </div>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 mb-3">{moduleData.title}</h1>
      <p class="text-gray-600">{moduleData.description}</p>
    </div>

    <ProgressTracker 
      client:load
      moduleId={moduleData.id}
      totalLessons={moduleData.lessons.length}
    />

    <div class="space-y-12">
      {moduleData.lessons.map((lesson, idx) => (
        <div id={lesson.id} class="scroll-mt-24">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-sm font-mono bg-blue-100 text-blue-700 px-2 py-0.5 rounded">
              Lesson {idx + 1}
            </span>
            <span class="text-sm text-gray-500">{lesson.duration}</span>
            <span class="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded capitalize">{lesson.type}</span>
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-6">{lesson.title}</h2>

          <div class="prose max-w-none bg-white rounded-xl border border-gray-200 p-8" set:html={
            lesson.content.split('\n').map(line => {
              // Process bold and inline code first for all lines
              const process = (text: string) =>
                text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/`(.*?)`/g, '<code>$1</code>');
              if (line.startsWith('# ')) return `<h1>${process(line.slice(2))}</h1>`;
              if (line.startsWith('## ')) return `<h2>${process(line.slice(3))}</h2>`;
              if (line.startsWith('### ')) return `<h3>${process(line.slice(4))}</h3>`;
              if (line.startsWith('- ')) return `<li>${process(line.slice(2))}</li>`;
              if (line.startsWith('  - ')) return `<li class="ml-4">${process(line.slice(4))}</li>`;
              if (line.match(/^\d+\. /)) return `<li>${process(line.replace(/^\d+\. /, ''))}</li>`;
              if (line.startsWith('|') && line.includes('|')) return null;
              if (line.startsWith('---')) return '<hr>';
              if (line.trim() === '') return '<br>';
              return `<p>${process(line)}</p>`;
            }).filter(Boolean).join('\n')
          } />

          {lesson.bestPractices && lesson.bestPractices.length > 0 && (
            <div class="mt-8 space-y-4">
              <h3 class="text-xl font-bold text-gray-900 flex items-center gap-2">
                💡 Best Practices
              </h3>
              {lesson.bestPractices.map(bp => (
                <div class="bg-green-50 border border-green-200 rounded-xl p-6">
                  <h4 class="font-bold text-green-900 mb-2">{bp.title}</h4>
                  <p class="text-green-800 text-sm mb-4">{bp.description}</p>
                  
                  <div class="grid md:grid-cols-2 gap-4">
                    <div>
                      <h5 class="font-semibold text-green-800 text-sm mb-2">✅ Do This</h5>
                      <ul class="space-y-1">
                        {bp.tips.map(tip => (
                          <li class="text-sm text-green-700 flex items-start gap-2">
                            <span class="text-green-500 mt-0.5">•</span>
                            {tip}
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div>
                      <h5 class="font-semibold text-red-800 text-sm mb-2">❌ Avoid This</h5>
                      <ul class="space-y-1">
                        {bp.commonPitfalls.map(pitfall => (
                          <li class="text-sm text-red-700 flex items-start gap-2">
                            <span class="text-red-500 mt-0.5">•</span>
                            {pitfall}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}

          {lesson.quiz && lesson.quiz.length > 0 && (
            <div class="mt-8">
              <Quiz 
                client:load 
                questions={lesson.quiz} 
                lessonTitle={lesson.title}
                onComplete={(score) => {
                  // Score is saved via localStorage in the component
                }}
              />
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="mt-12 flex justify-between items-center">
      {moduleData.order > 1 ? (
        <a href={`/modules/${learningModules.find(m => m.order === moduleData.order - 1)?.id || ''}`} 
           class="px-4 py-2 border border-gray-300 rounded-lg text-sm hover:bg-gray-50 transition-colors">
          ← Previous Module
        </a>
      ) : <div />}
      {moduleData.order < learningModules.length ? (
        <a href={`/modules/${learningModules.find(m => m.order === moduleData.order + 1)?.id || ''}`}
           class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700 transition-colors">
          Next Module →
        </a>
      ) : (
        <a href="/checklist" class="px-4 py-2 bg-green-600 text-white rounded-lg text-sm hover:bg-green-700 transition-colors">
          Start Checklist →
        </a>
      )}
    </div>
  </div>
</Layout>