---
import Layout from '../../layouts/Layout.astro';
import { learningModules } from '../../data/learningModules';
---

<Layout title="Learning Modules" activePage="modules">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Learning Modules</h1>
      <p class="text-gray-600">Work through each module sequentially for the best learning experience.</p>
    </div>

    <div class="space-y-6">
      {learningModules.map((mod) => {
        const totalQuizQuestions = mod.lessons.reduce((acc, l) => acc + (l.quiz?.length || 0), 0);
        const hasBestPractices = mod.lessons.some(l => l.bestPractices && l.bestPractices.length > 0);
        return (
          <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
            <a href={`/modules/${mod.id}`} class="block p-6">
              <div class="flex items-start gap-4">
                <span class="text-4xl">{mod.icon}</span>
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <span class="text-xs font-mono bg-gray-100 text-gray-500 px-2 py-0.5 rounded">Module {mod.order}</span>
                    <span class="text-sm text-gray-500">{mod.duration}</span>
                    <span class="text-sm text-gray-500">{mod.lessons.length} lessons</span>
                  </div>
                  <h2 class="text-xl font-bold text-gray-900 mb-2 hover:text-blue-600 transition-colors">{mod.title}</h2>
                  <p class="text-gray-600 mb-4">{mod.description}</p>
                  <div class="flex flex-wrap gap-2">
                    {totalQuizQuestions > 0 && (
                      <span class="inline-flex items-center gap-1 text-xs bg-blue-50 text-blue-700 px-3 py-1 rounded-full">
                        📝 {totalQuizQuestions} Quiz Questions
                      </span>
                    )}
                    {hasBestPractices && (
                      <span class="inline-flex items-center gap-1 text-xs bg-green-50 text-green-700 px-3 py-1 rounded-full">
                        💡 Best Practices
                      </span>
                    )}
                    {mod.lessons.some(l => l.type === 'exercise') && (
                      <span class="inline-flex items-center gap-1 text-xs bg-purple-50 text-purple-700 px-3 py-1 rounded-full">
                        🔧 Exercises
                      </span>
                    )}
                  </div>
                </div>
                <span class="text-blue-600 text-sm font-medium hidden sm:block mt-2">View →</span>
              </div>
            </a>
            <div class="border-t border-gray-100 px-6 py-3 bg-gray-50">
              <div class="flex flex-wrap gap-3 text-sm text-gray-600">
                {mod.lessons.map((lesson) => (
                  <a href={`/modules/${mod.id}?lesson=${lesson.id}`} class="hover:text-blue-600 transition-colors">
                    {lesson.title}
                  </a>
                ))}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Layout>