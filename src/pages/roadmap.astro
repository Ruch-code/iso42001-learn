---
import Layout from '../layouts/Layout.astro';
---

<Layout title="30-45 Day Roadmap" activePage="roadmap">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">30-45 Day Implementation Roadmap</h1>
        <p class="text-gray-600 text-lg">Track your progress week-by-week with visual milestones</p>
      </div>
      <a href="/ISO_42001_Roadmap_Checklist.xlsx" download class="mt-4 sm:mt-0 inline-flex items-center gap-2 bg-green-600 text-white px-5 py-2.5 rounded-lg hover:bg-green-700 transition font-medium">
        📥 Download Excel Checklist
      </a>
    </div>

    <!-- Progress Overview -->
    <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-8">
      <div class="flex flex-col md:flex-row items-center gap-8">
        <!-- Progress Ring -->
        <div class="relative">
          <svg width="140" height="140" viewBox="0 0 140 140">
            <circle cx="70" cy="70" r="60" stroke="#e5e7eb" stroke-width="10" fill="none"/>
            <circle id="progressRing" cx="70" cy="70" r="60" stroke="#2563eb" stroke-width="10" fill="none"
              stroke-dasharray="377" stroke-dashoffset="377" stroke-linecap="round"
              transform="rotate(-90 70 70)" style="transition: stroke-dashoffset 1s ease"/>
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span id="progressPercent" class="text-3xl font-bold text-gray-900">0%</span>
            <span class="text-xs text-gray-500">Complete</span>
          </div>
        </div>
        <div class="flex-1 grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="text-center p-3 bg-blue-50 rounded-xl">
            <div class="text-2xl font-bold text-blue-600" id="week1Count">0/6</div>
            <div class="text-xs text-blue-700 font-medium">Week 1</div>
          </div>
          <div class="text-center p-3 bg-purple-50 rounded-xl">
            <div class="text-2xl font-bold text-purple-600" id="week2Count">0/6</div>
            <div class="text-xs text-purple-700 font-medium">Week 2</div>
          </div>
          <div class="text-center p-3 bg-green-50 rounded-xl">
            <div class="text-2xl font-bold text-green-600" id="week3Count">0/5</div>
            <div class="text-xs text-green-700 font-medium">Week 3</div>
          </div>
          <div class="text-center p-3 bg-orange-50 rounded-xl">
            <div class="text-2xl font-bold text-orange-600" id="week4Count">0/5</div>
            <div class="text-xs text-orange-700 font-medium">Week 4</div>
          </div>
        </div>
        <button onclick="resetChecklist()" class="text-sm text-gray-400 hover:text-red-500 transition underline">Reset All</button>
      </div>
    </div>

    <!-- Visual Timeline -->
    <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-8">
      <h2 class="text-xl font-bold text-gray-900 mb-6">Implementation Timeline</h2>
      <div class="relative">
        <!-- Timeline Track -->
        <div class="flex items-center justify-between mb-2">
          <div class="flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold shadow-lg ring-4 ring-blue-100">D1</div>
            <span class="text-xs text-gray-500 mt-1 font-medium">Start</span>
          </div>
          <div class="flex-1 h-1 bg-gray-200 mx-2 relative">
            <div id="timelineFill1" class="absolute inset-y-0 left-0 bg-blue-500 rounded transition-all duration-700" style="width: 0%"></div>
          </div>
          <div class="flex flex-col items-center">
            <div id="milestone30" class="w-12 h-12 rounded-full bg-white border-4 border-gray-300 text-gray-400 flex items-center justify-center text-xs font-bold shadow transition-all duration-500">30d</div>
            <span class="text-xs text-gray-500 mt-1 font-medium">Day 30</span>
          </div>
          <div class="flex-1 h-1 bg-gray-200 mx-2 relative">
            <div id="timelineFill2" class="absolute inset-y-0 left-0 bg-purple-500 rounded transition-all duration-700" style="width: 0%"></div>
          </div>
          <div class="flex flex-col items-center">
            <div id="milestone35" class="w-12 h-12 rounded-full bg-white border-4 border-gray-300 text-gray-400 flex items-center justify-center text-xs font-bold shadow transition-all duration-500">35d</div>
            <span class="text-xs text-gray-500 mt-1 font-medium">Day 35</span>
          </div>
          <div class="flex-1 h-1 bg-gray-200 mx-2 relative">
            <div id="timelineFill3" class="absolute inset-y-0 left-0 bg-green-500 rounded transition-all duration-700" style="width: 0%"></div>
          </div>
          <div class="flex flex-col items-center">
            <div id="milestone45" class="w-12 h-12 rounded-full bg-white border-4 border-gray-300 text-gray-400 flex items-center justify-center text-xs font-bold shadow transition-all duration-500">45d</div>
            <span class="text-xs text-gray-500 mt-1 font-medium">Day 45</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Week 1 -->
    <div class="mb-6 bg-white rounded-2xl border border-gray-200 overflow-hidden">
      <div class="bg-blue-600 px-6 py-4 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-white">Week 1: Foundation & Gap Analysis</h2>
          <p class="text-blue-100 text-sm">Days 1-7: Understand the standard and assess current state</p>
        </div>
        <span class="bg-blue-500 text-white px-3 py-1 rounded-full text-sm font-medium" id="week1Badge">0/6</span>
      </div>
      <div class="divide-y divide-gray-100" id="week1">
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500" data-week="1" data-index="0">
          <div><p class="font-medium text-gray-900">Read ISO 42001 Clauses 4-10</p><p class="text-sm text-gray-500">Understand the management system requirements (context, leadership, planning, support, operation, performance evaluation, improvement)</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500" data-week="1" data-index="1">
          <div><p class="font-medium text-gray-900">Read Annex A Controls (A.2-A.10)</p><p class="text-sm text-gray-500">Learn all 38 controls across policy, organization, resources, data, development, operations, assessment, and third parties</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500" data-week="1" data-index="2">
          <div><p class="font-medium text-gray-900">Complete Learning Modules 1-2</p><p class="text-sm text-gray-500">ISO 42001 Fundamentals and AI Policy Development</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500" data-week="1" data-index="3">
          <div><p class="font-medium text-gray-900">Conduct Initial Gap Analysis</p><p class="text-sm text-gray-500">Document current state vs. ISO 42001 requirements</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500" data-week="1" data-index="4">
          <div><p class="font-medium text-gray-900">Review ISO 27001 overlap controls</p><p class="text-sm text-gray-500">Check if client has ISO 27001: leverage existing controls</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500" data-week="1" data-index="5">
          <div><p class="font-medium text-gray-900">Identify AI systems in scope</p><p class="text-sm text-gray-500">Inventory all AI/ML systems and their risk levels</p></div>
        </label>
      </div>
    </div>

    <!-- Week 2 -->
    <div class="mb-6 bg-white rounded-2xl border border-gray-200 overflow-hidden">
      <div class="bg-purple-600 px-6 py-4 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-white">Week 2: Policy & Governance</h2>
          <p class="text-purple-100 text-sm">Days 8-14: Establish governance framework and policies</p>
        </div>
        <span class="bg-purple-500 text-white px-3 py-1 rounded-full text-sm font-medium" id="week2Badge">0/6</span>
      </div>
      <div class="divide-y divide-gray-100" id="week2">
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-purple-600 focus:ring-purple-500" data-week="2" data-index="0">
          <div><p class="font-medium text-gray-900">Draft AI Policy</p><p class="text-sm text-gray-500">Create the core AI policy document aligned with A.2.1</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-purple-600 focus:ring-purple-500" data-week="2" data-index="1">
          <div><p class="font-medium text-gray-900">Define Roles & Responsibilities</p><p class="text-sm text-gray-500">Assign AI governance roles — owner, risk officer, ethics lead (A.3.1)</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-purple-600 focus:ring-purple-500" data-week="2" data-index="2">
          <div><p class="font-medium text-gray-900">Complete Learning Module 3</p><p class="text-sm text-gray-500">AI Risk Assessment & Treatment</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-purple-600 focus:ring-purple-500" data-week="2" data-index="3">
          <div><p class="font-medium text-gray-900">Establish Risk Assessment Process</p><p class="text-sm text-gray-500">Define methodology for AI risk identification and assessment (Clause 6.1)</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-purple-600 focus:ring-purple-500" data-week="2" data-index="4">
          <div><p class="font-medium text-gray-900">Create Document Control Process</p><p class="text-sm text-gray-500">Set up document management system for AISMS records (A.7.5)</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-purple-600 focus:ring-purple-500" data-week="2" data-index="5">
          <div><p class="font-medium text-gray-900">Map existing controls to ISO 42001</p><p class="text-sm text-gray-500">Identify which existing controls satisfy Annex A requirements</p></div>
        </label>
      </div>
    </div>

    <!-- Week 3 -->
    <div class="mb-6 bg-white rounded-2xl border border-gray-200 overflow-hidden">
      <div class="bg-green-600 px-6 py-4 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-white">Week 3: Implementation & Controls</h2>
          <p class="text-green-100 text-sm">Days 15-21: Implement required controls and processes</p>
        </div>
        <span class="bg-green-500 text-white px-3 py-1 rounded-full text-sm font-medium" id="week3Badge">0/5</span>
      </div>
      <div class="divide-y divide-gray-100" id="week3">
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-green-600 focus:ring-green-500" data-week="3" data-index="0">
          <div><p class="font-medium text-gray-900">Complete Learning Module 4</p><p class="text-sm text-gray-500">Controls Implementation & Operations</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-green-600 focus:ring-green-500" data-week="3" data-index="1">
          <div><p class="font-medium text-gray-900">Implement AI Data Governance (A.6)</p><p class="text-sm text-gray-500">Data quality, provenance, bias monitoring, training data controls</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-green-600 focus:ring-green-500" data-week="3" data-index="2">
          <div><p class="font-medium text-gray-900">Implement AI Development Controls (A.5)</p><p class="text-sm text-gray-500">Lifecycle processes, verification, documentation (A.5.1-A.5.5)</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-green-600 focus:ring-green-500" data-week="3" data-index="3">
          <div><p class="font-medium text-gray-900">Set Up Monitoring & Logging (A.8.3)</p><p class="text-sm text-gray-500">Implement continuous monitoring for AI system performance and drift</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-green-600 focus:ring-green-500" data-week="3" data-index="4">
          <div><p class="font-medium text-gray-900">Conduct AI Impact Assessment</p><p class="text-sm text-gray-500">Complete AIIA for all in-scope AI systems (Clause 8.2)</p></div>
        </label>
      </div>
    </div>

    <!-- Week 4 -->
    <div class="mb-6 bg-white rounded-2xl border border-gray-200 overflow-hidden">
      <div class="bg-orange-600 px-6 py-4 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-white">Week 4+ — Audit Prep & Certification</h2>
          <p class="text-orange-100 text-sm">Days 22-45: Internal audit, review, and certification readiness</p>
        </div>
        <span class="bg-orange-500 text-white px-3 py-1 rounded-full text-sm font-medium" id="week4Badge">0/5</span>
      </div>
      <div class="divide-y divide-gray-100" id="week4">
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-orange-600 focus:ring-orange-500" data-week="4" data-index="0">
          <div><p class="font-medium text-gray-900">Complete Learning Modules 5-6</p><p class="text-sm text-gray-500">Audit Preparation and Certification Process</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-orange-600 focus:ring-orange-500" data-week="4" data-index="1">
          <div><p class="font-medium text-gray-900">Conduct Internal Audit</p><p class="text-sm text-gray-500">Perform full internal audit against all ISO 42001 requirements (Clause 9.2)</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-orange-600 focus:ring-orange-500" data-week="4" data-index="2">
          <div><p class="font-medium text-gray-900">Management Review</p><p class="text-sm text-gray-500">Present AISMS status to leadership for formal review and approval (Clause 9.3)</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-orange-600 focus:ring-orange-500" data-week="4" data-index="3">
          <div><p class="font-medium text-gray-900">Address Non-Conformities</p><p class="text-sm text-gray-500">Close all audit findings and implement corrective actions (Clause 10.1)</p></div>
        </label>
        <label class="checklist-item flex items-center gap-4 p-4 cursor-pointer hover:bg-gray-50 transition">
          <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-orange-600 focus:ring-orange-500" data-week="4" data-index="4">
          <div><p class="font-medium text-gray-900">Schedule Certification Audit</p><p class="text-sm text-gray-500">Engage certification body and prepare documentation package</p></div>
        </label>
      </div>
    </div>
  </div>

  <script is:inline>
    const WEEK_COUNTS = { 1: 6, 2: 6, 3: 5, 4: 5 };
    const TOTAL = Object.values(WEEK_COUNTS).reduce((a, b) => a + b, 0);
    const STORAGE_KEY = 'iso42001-roadmap-progress';

    function loadProgress() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch { return {}; }
    }

    function saveProgress(progress) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
    }

    function updateUI() {
      const progress = loadProgress();
      let completed = 0;
      let weekCompleted = { 1: 0, 2: 0, 3: 0, 4: 0 };

      for (const [week, count] of Object.entries(WEEK_COUNTS)) {
        for (let i = 0; i < count; i++) {
          const key = `w${week}-${i}`;
          if (progress[key]) {
            completed++;
            weekCompleted[week]++;
          }
        }
      }

      // Update progress ring
      const pct = Math.round((completed / TOTAL) * 100);
      const circumference = 2 * Math.PI * 60;
      const offset = circumference - (completed / TOTAL) * circumference;
      document.getElementById('progressRing').style.strokeDashoffset = offset;
      document.getElementById('progressPercent').textContent = pct + '%';

      // Update week counts and badges
      for (let w = 1; w <= 4; w++) {
        const countEl = document.getElementById(`week${w}Count`);
        const badgeEl = document.getElementById(`week${w}Badge`);
        if (countEl) countEl.textContent = `${weekCompleted[w]}/${WEEK_COUNTS[w]}`;
        if (badgeEl) badgeEl.textContent = `${weekCompleted[w]}/${WEEK_COUNTS[w]}`;
      }

      // Update timeline milestones
      const w1Pct = (weekCompleted[1] / WEEK_COUNTS[1]) * 100;
      const w2Pct = (weekCompleted[2] / WEEK_COUNTS[2]) * 100;
      const w3Pct = (weekCompleted[3] / WEEK_COUNTS[3]) * 100;
      const w4Pct = (weekCompleted[4] / WEEK_COUNTS[4]) * 100;

      document.getElementById('timelineFill1').style.width = w1Pct + '%';
      document.getElementById('timelineFill2').style.width = w2Pct + '%';
      document.getElementById('timelineFill3').style.width = w3Pct + '%';

      const m30 = document.getElementById('milestone30');
      const m35 = document.getElementById('milestone35');
      const m45 = document.getElementById('milestone45');

      if (w1Pct >= 100 && w2Pct >= 50) {
        m30.className = m30.className.replace('border-gray-300 text-gray-400', 'border-green-500 text-white bg-green-600');
      }
      if (w2Pct >= 100 && w3Pct >= 50) {
        m35.className = m35.className.replace('border-gray-300 text-gray-400', 'border-green-500 text-white bg-green-600');
      }
      if (completed === TOTAL) {
        m45.className = m45.className.replace('border-gray-300 text-gray-400', 'border-green-500 text-white bg-green-600');
      }
    }

    function initCheckboxes() {
      const progress = loadProgress();
      document.querySelectorAll('input[type="checkbox"]').forEach(cb => {
        const key = `w${cb.dataset.week}-${cb.dataset.index}`;
        cb.checked = !!progress[key];
        cb.addEventListener('change', () => {
          const progress = loadProgress();
          if (cb.checked) progress[key] = true;
          else delete progress[key];
          saveProgress(progress);
          updateUI();
        });
      });
    }

    function resetChecklist() {
      if (!confirm('Reset all progress? This cannot be undone.')) return;
      localStorage.removeItem(STORAGE_KEY);
      document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
      updateUI();
    }

    document.addEventListener('DOMContentLoaded', () => {
      initCheckboxes();
      updateUI();
    });
  </script>

  <!-- Stage 4: Surveillance & Maintenance (Year 2-3) -->
  <div id="stage-4" class="mb-8 animate-on-scroll">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Stage 4: Surveillance & Maintenance</h2>
    <p class="text-gray-600 mb-4">Maintain the AIMS through regular surveillance audits and continual improvement. Two surveillance audits occur in Years 2 and 3, not once per year for three years. The recertification audit takes place in Year 3, before certificate expiry.</p>
    
    <!-- 4.1 Post-certification transition -->
    <section id="4-1" class="mb-6">
      <h3 class="text-xl font-bold text-gray-900 mb-3">4.1 Post-certification transition (Months 1-3)</h3>
      <p class="text-gray-600 mb-4">Close out Stage 2 minor nonconformities within the certification body's deadline; verify effectiveness. Hand over from implementation project to BAU ownership; RACI for ongoing AIMS operation. Build a 3-year compliance calendar (internal audits, management reviews, risk reviews, AI impact assessments, training, surveillance dates).</p>
    </section>
    
    <!-- 4.2 Ongoing operation of the AIMS -->
    <section id="4-2" class="mb-6">
      <h3 class="text-xl font-bold text-gray-900 mb-3">4.2 Ongoing operation of the AIMS</h3>
      <ul class="list-disc list-inside text-gray-600 mb-4">
        <li>AI system inventory maintenance and change triggers (new model, retraining, new data source, new use case, vendor/model provider change, decommissioning)</li>
        <li>Periodic AI risk assessment and AI system impact assessment refresh (Clause 6.1, 8.2-8.4)</li>
        <li>Statement of Applicability review</li>
        <li>Third-party / AI supplier monitoring (A.10)</li>
        <li>Data quality, provenance and model monitoring (drift, bias, performance), incident logging</li>
        <li>Competence and awareness refresh training (Clause 7.2, 7.3)</li>
        <li>Documented information control and version history</li>
      </ul>
    </section>
    
    <!-- 4.3 In-depth Performance Evaluation (Clause 9) -->
    <section id="4-3" class="mb-6">
      <h3 class="text-xl font-bold text-gray-900 mb-3">4.3 In-depth Performance Evaluation (Clause 9)</h3>
      <p class="text-gray-600 mb-4">The most detailed part of Stage 4:</p>
      <div class="bg-white rounded-lg border border-gray-200 p-4 mb-6">
        <h4 class="font-medium text-gray-700 mb-3">9.1 Monitoring, measurement, analysis and evaluation</h4>
        <div class="overflow-x-auto">
          <table class="w-full caption-bottom text-sm">
            <caption class="text-gray-500 text-sm mb-4">KPI/KRI Table</caption>
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left text-xs font-semibold text-gray-600 py-3 px-4">Metric</th>
                <th class="text-left text-xs font-semibold text-gray-600 py-3 px-4">What it measures</th>
                <th class="text-left text-xs font-semibold text-gray-600 py-3 px-4">Example target</th>
                <th class="text-left text-xs font-semibold text-gray-600 py-3 px-4">Data source</th>
                <th class="text-left text-xs font-semibold text-gray-600 py-3 px-4">Frequency</th>
                <th class="text-left text-xs font-semibold text-gray-600 py-3 px-4">Owner</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
