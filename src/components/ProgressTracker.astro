<script is:inline>
  // Progress tracking UI component
  class ProgressTracker {
    constructor() {
      this.init();
    }

    init() {
      // Listen for progress updates
      window.addEventListener('storage', (e) => {
        if (e.key === 'iso42001-progress') {
          this.updateUI();
        }
      });
      this.updateUI();
    }

    updateUI() {
      // Update progress bars on page
      const progressBars = document.querySelectorAll('[data-progress-bar]');
      progressBars.forEach(bar => {
        const moduleId = bar.dataset.moduleId;
        if (moduleId) {
          const progress = this.getModuleProgress(moduleId);
          const fill = bar.querySelector('.progress-fill');
          const text = bar.querySelector('.progress-text');
          if (fill) fill.style.width = `${Math.round((Object.keys(progress.lessons || {}).filter(l => l.completed).length / Math.max(Object.keys(progress.lessons || {}).length, 1)) * 100)}%`;
          if (text) text.textContent = `${Math.round((Object.keys(progress.lessons || {}).filter(l => l.completed).length / Math.max(Object.keys(progress.lessons || {}).length, 1)) * 100)}%`;
        }
      });

      // Update overall progress
      const overallProgress = this.getOverallProgress();
      const overallBars = document.querySelectorAll('[data-overall-progress]');
      overallBars.forEach(bar => {
        const fill = bar.querySelector('.progress-fill');
        const text = bar.querySelector('.progress-text');
        if (fill) fill.style.width = `${overallProgress.percentage}%`;
        if (text) text.textContent = `${overallProgress.percentage}% Complete`;
      });

      // Update checklist counters
      const checklists = document.querySelectorAll('[data-checklist-count]');
      checklists.forEach(el => {
        const count = Object.values(this.getChecklistProgress() || {}).filter(c => c.completed).length;
        el.textContent = count;
      });

      // Update module completion badges
      document.querySelectorAll('[data-module-complete]').forEach(badge => {
        const moduleId = badge.dataset.moduleId;
        const progress = this.getModuleProgress(moduleId);
        badge.textContent = badge.dataset.moduleCompleted ? '✓ Completed' : 'In Progress';
        badge.classList.toggle('text-green-600', progress.completed);
        badge.classList.toggle('text-gray-500', !progress.completed);
      });
    }

    getModuleProgress(moduleId) {
      try {
        const progress = JSON.parse(localStorage.getItem('iso42001-progress') || '{}');
        return progress.modules?.[moduleId] || { completed: false, lessons: {} };
      } catch {
        return { completed: false, lessons: {} };
      }
    }

    getOverallProgress() {
      const progress = JSON.parse(localStorage.getItem('iso42001-progress') || '{}');
      const modules = progress.modules || {};
      let completedModules = 0;
      let totalLessons = 0;
      let completedLessons = 0;

      Object.values(modules).forEach(mod => {
        if (mod.completed) completedModules++;
        Object.values(modules).forEach(mod => {
          Object.values(mod.lessons || {}).forEach(lesson => {
            if (lesson.completed) completedLessons++;
            totalLessons++;
          });
        });
      });

      return {
        modules: { completed: Object.values(modules).filter(m => m.completed).length, total: 6 },
        lessons: { completed: Object.values(modules).reduce((sum, m) => sum + Object.values(m.lessons || {}).filter(l => l.completed).length, 0), total: Object.values(modules).reduce((sum, m) => sum + Object.keys(m.lessons || {}).length, 0) },
        percentage: totalLessons > 0 ? Math.round((Object.values(modules).reduce((sum, m) => sum + Object.values(m.lessons || {}).filter(l => l.completed).length, 0) / totalLessons) * 100) : 0
      };
    }
  }
</script>

<div id="progress-tracker" class="hidden" aria-hidden="true">
  <!-- This component manages progress tracking via localStorage -->
  <!-- It updates progress bars and completion status across all pages -->
</div>