<script>
  // Progress tracking with localStorage
  const PROGRESS_KEY = 'iso42001-progress';
  const STORAGE_KEYS = {
    modules: 'iso42001-modules-progress',
    lessons: 'iso42001-lessons-progress',
    checklist: 'iso42001-checklist-progress',
    notes: 'iso42001-notes'
  };

  function getProgress() {
    try {
      return JSON.parse(localStorage.getItem('iso42001-progress') || '{}');
    } catch {
      return {};
    }
  }

  function saveProgress(data) {
    localStorage.setItem('iso42001-progress', JSON.stringify(data));
  }

  function getModuleProgress(moduleId) {
    const progress = getProgress();
    return progress.modules?.[moduleId] || { completed: false, lessons: {} };
  }

  function setModuleProgress(moduleId, data) {
    const progress = getProgress();
    if (!progress.modules) progress.modules = {};
    progress.modules[moduleId] = { ...progress.modules[moduleId], ...data };
    localStorage.setItem('iso42001-progress', JSON.stringify(progress));
  }

  function getLessonProgress(moduleId, lessonId) {
    const moduleProgress = getModuleProgress(window.location.pathname.split('/')[2] || '');
    return progress.lessons?.[lessonId]?.completed || false;
  }

  function setLessonProgress(moduleId, lessonId, completed) {
    const progress = getProgress();
    if (!progress.modules) progress.modules = {};
    if (!progress.modules[moduleId]) progress.modules[moduleId] = { lessons: {} };
    if (!progress.modules[moduleId].lessons) progress.modules[moduleId].lessons = {};
    progress.modules[moduleId].lessons[lessonId] = { completed, timestamp: Date.now() };
    localStorage.setItem('iso42001-progress', JSON.stringify(progress));
  }

  function getChecklistProgress() {
    const progress = getProgress();
    return progress.checklist || {};
  }

  function setChecklistProgress(itemId, completed) {
    const progress = getProgress();
    if (!progress.checklist) progress.checklist = {};
    progress.checklist[itemId] = { completed, timestamp: Date.now() };
    localStorage.setItem('iso42001-progress', JSON.stringify(progress));
  }

  function getNotes() {
    try {
      return JSON.parse(localStorage.getItem('iso42001-notes') || '{}');
    } catch {
      return {};
    }
  }

  function saveNote(moduleId, note) {
    const notes = getNotes();
    notes[moduleId] = note;
    localStorage.setItem('iso42001-notes', JSON.stringify(notes));
  }

  function getModuleProgress2(moduleId) {
    const progress = getProgress();
    return progress.modules?.[moduleId] || { completed: false, lessons: {} };
  }

  function getOverallProgress() {
    const progress = getProgress();
    const modules = progress.modules || {};
    const totalModules = 6;
    let completedModules = 0;
    let totalLessons = 0;
    let completedLessons = 0;

    Object.values(progress.modules || {}).forEach(mod => {
      if (mod.completed) completedModules++;
      Object.values(mod.lessons || {}).forEach(lesson => {
        totalLessons++;
        if (lesson.completed) completedLessons++;
      });
    });

    return {
      modules: { completed: completedModules, total: 6 },
      lessons: { completed: completedLessons, total: totalLessons },
      percentage: totalLessons > 0 ? Math.round((completedLessons / totalLessons) * 100) : 0
    };
  }

  // Export for use in other components
  window.ISO42001Progress = {
    getProgress,
    saveProgress,
    getModuleProgress,
    setModuleProgress,
    getLessonProgress,
    setLessonProgress,
    getChecklistProgress,
    setChecklistProgress,
    getNotes,
    saveNote,
    getOverallProgress
  };
</script>

