---
import Chatbot from '../components/Chatbot.tsx';
import FloatingRobot from '../components/FloatingRobot.tsx';
import BackgroundParticles from '../components/BackgroundParticles.tsx';
import ScrollAnimations from '../components/ScrollAnimations.tsx';
import CustomCursor from '../components/CustomCursor.tsx';
import AuthProvider from '../components/auth/AuthProvider.tsx';
import AuthWidget from '../components/auth/AuthWidget.tsx';
import ThemeToggle from '../components/ThemeToggle.astro';
import MobileMenu from '../components/MobileMenu.astro';
import SearchBar from '../components/SearchBar.astro';
// import ReferenceDrawer from '../components/ReferenceDrawer.astro';
import ProgressTracker from '../components/ProgressTracker.astro';

interface Props {
  title: string;
  activePage?: string;
}

const { title, activePage = '' } = Astro.props;
const navItems = [
  { href: '/', label: 'Home', id: 'home' },
  { href: '/modules', label: 'Learning', id: 'modules' },
  { href: '/roadmap', label: 'Roadmap', id: 'roadmap' },
  { href: '/overlap', label: '27001↔42001', id: 'overlap' },
  { href: '/euai', label: 'EU AI Act', id: 'euai' },
  { href: '/nist', label: 'NIST 600-1', id: 'nist' },
  { href: '/reference', label: 'Reference', id: 'reference' },
  { href: '/checklist', label: 'Checklist', id: 'checklist' }
];
---

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | ISO 42001 Learn</title>
  <meta name="description" content="ISO 42001 AI Management System training platform for new hires" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" async></script>
  <script is:inline>
    // Initialize theme from localStorage before render to prevent flash
    (function() {
      try {
        var theme = localStorage.getItem('theme');
        var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>
</head>
<body class="bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-screen flex flex-col antialiased transition-colors duration-300">
  <AuthProvider client:load>
    <ThemeToggle client:load />
    <MobileMenu client:load />
    <SearchBar client:load />
    
    <ProgressTracker client:load />
    <BackgroundParticles />
    <FloatingRobot />
    <Chatbot client:load />
    <ScrollAnimations client:load />
    <CustomCursor client:load />
    <AuthWidget client:load />
  <nav class="bg-white dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 py-2">
        <div class="flex items-center gap-2">
          <a href="/" class="flex items-center gap-2" aria-label="ISO 42001 Learn Home">
            <span class="text-2xl" aria-hidden="true">🛡️</span>
            <span class="font-bold text-lg text-gray-900 dark:text-white">ISO 42001</span>
          </a>
          <MenuButton class="md:hidden p-2 rounded-lg text-gray-500 hover:text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 transition-colors" aria-label="Open navigation menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </MenuButton>
          <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
            {navItems.map(item => (
              <a
                href={item.href}
                class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors nav-underline ${
                  activePage === item.id
                    ? 'bg-blue-50 text-blue-700 dark:bg-blue-900/30 text-blue-400'
                    : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white'
                }`}
                href={item.href}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
        <div class="flex items-center gap-4">
          <div class="hidden sm:flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
            <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse" aria-hidden="true"></span>
            ISO 42001:2023
          </div>
          <a href="https://www.iso.org/standard/81230.html" target="_blank" rel="noopener" class="text-sm text-blue-600 hover:text-blue-800 dark:text-blue-400 hidden sm:inline">
            Official Standard ↗
          </a>
          <ThemeToggle client:load />
          <AuthWidget client:load />
          <MobileMenu client:load />
        </div>
      </div>
    </div>
  </nav>

  <MobileMenu client:load />
  

  <main class="flex-1 relative z-10">
    <slot />
  </main>

  <SearchBar client:load />
  
  <ProgressTracker client:load />

  <CustomCursor client:load />
  <BackgroundParticles />
  <FloatingRobot />
  <Chatbot client:load />
  <ScrollAnimations client:load />
  <AuthWidget client:load />

  <footer class="bg-white dark:bg-gray-950 border-t border-gray-200 dark:border-gray-800 mt-auto relative z-10">
    <div class="max-w-7xl mx-auto px-4 py-6 text-center text-sm text-gray-500 dark:text-gray-400">
      <p>ISO 42001 Learning Platform — Internal Training Resource</p>
      <p class="mt-1">Based on ISO/IEC 42001:2023 — Information technology — Artificial intelligence — Management system</p>
      <p class="mt-2 text-gray-400 text-xs">Created by <strong class="text-gray-500">Ruchi Kandpal</strong></p>
    </div>
  </footer>
  </AuthProvider>

  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" async></script>
  <script is:inline>
    // Progress tracking visitor counter
    (function () {
      var pvEl = document.getElementById('site-pv');
      var uvEl = document.getElementById('site-uv');
      var UV_KEY = 'iso42001-session-uv';
      var PV_KEY = 'iso42001-session-pv';

      function bumpLocal() {
        var uv = parseInt(localStorage.getItem('iso42001-session-uv') || '0', 10);
        var pv = parseInt(localStorage.getItem('iso42001-session-pv') || '0', 10);
        if (!sessionStorage.getItem('iso42001-session-uv-done')) {
          sessionStorage.setItem('iso42001-session-uv-done', '1');
          uv += 1;
          localStorage.setItem('iso42001-session-uv', String(uv));
        }
        pv += 1;
        localStorage.setItem('iso42001-session-pv', String(pv));
        return { uv: uv, pv: pv };
      }

      setTimeout(function () {
        var pvVal = pvEl ? pvEl.textContent.trim() : '';
        var uvVal = uvEl ? uvEl.textContent.trim() : '';
        if (!pvVal || pvVal === '…' || !uvVal || uvVal === '…') {
          var c = bumpLocal();
          if (pvEl) pvEl.textContent = c.pv;
          if (uvEl) uvEl.textContent = c.uv;
        } else {
          bumpLocal();
        }
      }, 5000);
    })();
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
</html>