---
import Chatbot from '../components/Chatbot.tsx';
import FloatingRobot from '../components/FloatingRobot.tsx';
import BackgroundParticles from '../components/BackgroundParticles.tsx';
import ScrollAnimations from '../components/ScrollAnimations.tsx';

interface Props {
  title: string;
  activePage?: string;
}

const { title, activePage = '' } = Astro.props;
const navItems = [
  { href: '/', label: 'Home', id: 'home' },
  { href: '/modules', label: 'Learning', id: 'modules' },
  { href: '/roadmap', label: 'Roadmap', id: 'roadmap' },
  { href: '/overlap', label: '27001↔42001', id: 'overlap' },
  { href: '/euai', label: 'EU AI Act', id: 'euai' },
  { href: '/nist', label: 'NIST 600-1', id: 'nist' },
  { href: '/reference', label: 'Reference', id: 'reference' },
  { href: '/checklist', label: 'Checklist', id: 'checklist' }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | ISO 42001 Learn</title>
  <meta name="description" content="ISO 42001 AI Management System training platform for new hires" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">
  <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center gap-8">
          <a href="/" class="flex items-center gap-2">
            <span class="text-2xl">🛡️</span>
            <span class="font-bold text-lg text-gray-900">ISO 42001</span>
            <span class="text-sm text-gray-500 hidden sm:inline">Learn</span>
          </a>
          <div class="hidden md:flex items-center gap-1">
            {navItems.map(item => (
              <a
                href={item.href}
                class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors nav-underline ${
                  activePage === item.id
                    ? 'bg-blue-50 text-blue-700'
                    : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'
                }`}
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="hidden sm:flex items-center gap-2 text-sm text-gray-500">
            <span class="w-2 h-2 rounded-full bg-green-400"></span>
            ISO 42001:2023
          </div>
          <a href="https://www.iso.org/standard/81230.html" target="_blank" class="text-sm text-blue-600 hover:text-blue-800 hidden sm:inline">
            Official Standard ↗
          </a>
        </div>
      </div>
    </div>
    <div class="md:hidden border-t border-gray-100">
      <div class="flex justify-around py-2">
        {navItems.map(item => (
          <a
            href={item.href}
            class={`flex flex-col items-center gap-1 px-3 py-1 text-xs ${
              activePage === item.id ? 'text-blue-600' : 'text-gray-500'
            }`}
          >
            {item.id === 'home' && '🏠'}
            {item.id === 'modules' && '📚'}
            {item.id === 'roadmap' && '🚀'}
            {item.id === 'overlap' && '🔗'}
            {item.id === 'euai' && '🇪🇺'}
            {item.id === 'nist' && '🇺🇸'}
            {item.id === 'reference' && '📖'}
            {item.id === 'checklist' && '✅'}
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <main class="flex-1 relative z-10">
    <slot />
  </main>

  <BackgroundParticles />
  <FloatingRobot />
  <Chatbot client:load />
  <ScrollAnimations client:load />

  <footer class="bg-white border-t border-gray-200 mt-auto relative z-10">
    <div class="max-w-7xl mx-auto px-4 py-6 text-center text-sm text-gray-500">
      <p>ISO 42001 Learning Platform — Internal Training Resource</p>
      <p class="mt-1">Based on ISO/IEC 42001:2023 — Information technology — Artificial intelligence — Management system</p>
    </div>
  </footer>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
  
  .prose h1 { font-size: 1.875rem; font-weight: 700; margin-bottom: 1rem; color: #111827; }
  .prose h2 { font-size: 1.5rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; color: #1f2937; }
  .prose h3 { font-size: 1.25rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.5rem; color: #374151; }
  .prose p { margin-bottom: 1rem; line-height: 1.75; }
  .prose ul, .prose ol { margin-bottom: 1rem; padding-left: 1.5rem; }
  .prose li { margin-bottom: 0.25rem; line-height: 1.75; }
  .prose ul li { list-style-type: disc; }
  .prose ol li { list-style-type: decimal; }
  .prose strong { font-weight: 600; color: #111827; }
  .prose code { background: #f3f4f6; padding: 0.125rem 0.375rem; border-radius: 0.25rem; font-size: 0.875rem; }
  .prose table { width: 100%; border-collapse: collapse; margin-bottom: 1rem; }
  .prose th, .prose td { border: 1px solid #e5e7eb; padding: 0.5rem 0.75rem; text-align: left; }
  .prose th { background: #f9fafb; font-weight: 600; }
  .prose blockquote { border-left: 4px solid #3b82f6; padding-left: 1rem; margin-bottom: 1rem; color: #4b5563; font-style: italic; }
</style>